{
  "name": "bookleaf-support",
  "version": "1.0.0",
  "private": true,
  "description": "BookLeaf author support portal with React, Express and MongoDB",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "vite --host 127.0.0.1",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "package": "python3 scripts/package.py",
    "build": "vite build",
    "dev:server": "node --watch src/server.js",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "connect-mongo": "^5.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^5.0.0",
    "mongodb-memory-server": "^10.2.0",
    "prettier": "^3.9.10",
    "vite": "^7.1.0"
  }
}
