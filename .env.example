PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/bookleaf
# Optional override; an omitted URI database defaults to bookleaf.
MONGODB_DB_NAME=
# Set a long random secret before deploying. Development generates one if empty.
SESSION_SECRET=
# Demo seeding is explicit; disable and provision accounts before public deployment.
SEED_DEMO=true
DEMO_AUTHOR_PASSWORD=AuthorDemo!2026
DEMO_ADMIN_PASSWORD=AdminDemo!2026
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=12000
# Set only behind a trusted single reverse proxy in production.
TRUST_PROXY=false
